NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_PUBLIC_BASE_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_CORS_CREDENTIALS=true
APP_SWAGGER_ENABLED=true
APP_SWAGGER_PATH=docs
APP_SECURITY_HEADERS_ENABLED=true
APP_AUTH_PAYMENT_RATE_LIMIT_ENABLED=true
APP_AUTH_PAYMENT_RATE_LIMIT_WINDOW_MS=60000
APP_AUTH_PAYMENT_RATE_LIMIT_MAX=120
WS_NOTIFICATIONS_NAMESPACE=/notifications
WS_TICKETS_NAMESPACE=/tickets

MONGODB_URI=mongodb://127.0.0.1:27017/web_project

# JWT secrets are required and must be changed.
JWT_ACCESS_SECRET=please-change-this-access-secret
JWT_REFRESH_SECRET=please-change-this-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth email + reset code config
EMAIL_VERIFICATION_CODE_EXPIRES_IN_MINUTES=10
PASSWORD_RESET_CODE_EXPIRES_IN_MINUTES=10
TWO_FACTOR_ISSUER=DN Web Project
TWO_FACTOR_CHALLENGE_TTL_SECONDS=300
TWO_FACTOR_BACKUP_CODE_COUNT=10
# Must resolve to 32 bytes (examples: 64-hex, base64:<...>, or 32-char raw)
TWO_FACTOR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# SMTP config (if empty, backend logs mail preview instead of sending)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=<smtp_username>
MAIL_PASS=<smtp_password>
MAIL_FROM=no-reply@yourdomain.com

# MinIO / S3 config
S3_ENDPOINT=https://s3.devnguyen.me
S3_PORT=443
S3_USE_SSL=true
S3_INIT_BUCKETS=true
S3_ACCESS_KEY=<minio_access_key>
S3_SECRET_KEY=<minio_secret_key>
S3_REGION=us-east-1

# Bucket names
S3_BUCKET_BLOG_IMAGES=blog-images
S3_BUCKET_AVATARS=avatars
S3_BUCKET_PUBLIC=public
S3_BUCKET_PRODUCTS=products
S3_BUCKET_TICKETS=tickets

# Public URL for frontend file access
S3_PUBLIC_URL=https://s3.devnguyen.me

# Wallet / PayOS config
COIN_TO_VND_RATE=1000
POST_REWARD_COINS=1
DEPOSIT_FRAUD_WINDOW_MINUTES=15
DEPOSIT_FRAUD_THRESHOLD=3
DEPOSIT_FAILURE_WINDOW_MINUTES=30
SUBSCRIPTION_GRACE_DAYS=3

PAYOS_CLIENT_ID=<payos_client_id>
PAYOS_API_KEY=<payos_api_key>
PAYOS_CHECKSUM_KEY=<payos_checksum_key>
PAYOS_ENDPOINT=https://api-merchant.payos.vn/v2/payment-requests
PAYOS_PAYMENT_BASE_URL=https://pay.payos.vn/web
PAYOS_RETURN_URL=http://localhost:3000/wallet/payment-result
PAYOS_CANCEL_URL=http://localhost:3000/wallet/payment-result
PAYOS_WEBHOOK_URL=http://localhost:3000/api/v1/payment/payos/webhook
PAYOS_CURRENCY=VND

# Store / Orders config
STORE_OWNER_USER_ID=<admin_user_id>
STORE_PLATFORM_FEE_PERCENT=10
STORE_DOWNLOAD_URL_TTL_SECONDS=3600
STORE_AUTO_COMPLETE_DAYS=7
STORE_EMAIL_DOWNLOAD_TOKEN_SECRET=<strong_random_secret>
STORE_EMAIL_DOWNLOAD_TOKEN_TTL_SECONDS=604800
STORE_DELIVERY_EMAIL_ENABLED=true
